# AI / LLM
GROQ_API_KEY=your_groq_api_key_here

GROQ_MODEL=openai/gpt-oss-20b
# Used only if the configured model is unavailable or retired.
# Empty disables model retry.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Last.fm
LASTFM_API_KEY=

# MongoDB
MONGODB_URI=your_mongodb_uri
MONGODB_DATABASE=ai_music_curator

# Local database fallback
DATABASE_PATH=data/curator.sqlite3

# Local fallback music directory
# Leave empty to use fallback_songs/ under the project folder.
LOCAL_MUSIC_DIR=E:\AI_Music_Quratter\fallback_songs

# Frontend / CORS
# For local development + Vercel production.
ALLOWED_ORIGINS=https://soul-tune-ai-music-platform.vercel.app/,https://soultune-ai-music-platform-backend.onrender.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000

# Cookies
# Production on Render + Vercel:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Session lifetime
SESSION_HOURS=168
GUEST_SESSION_HOURS=24

# Environment
ENVIRONMENT=development